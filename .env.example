NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application & Public URL
NEXT_PUBLIC_APP_URL=https://krushios.vercel.app

# SMS Provider Configuration (Server-Only, MSG91 DLT Flow API v5)
# Keep provider credentials in server-side environment variables only
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=KRUSHI
MSG91_DLT_TE_ID_INVOICE=
MSG91_DLT_TE_ID_PAYMENT=
MSG91_DLT_TE_ID_REMINDER=
SMS_WEBHOOK_SECRET=

# Vercel Cron Secret (Secures /api/cron/process-sms background worker)
CRON_SECRET=your_random_secure_cron_secret

# SaaS Subscription Enforcement (Default: false to prevent accidental lockouts)
ENABLE_SUBSCRIPTION_ENFORCEMENT=false

# Distributed Rate Limiting (Optional Upstash Redis, falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Automated Database Backup Configuration
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_S3_BUCKET=

# Sentry Monitoring (Server & Client DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
